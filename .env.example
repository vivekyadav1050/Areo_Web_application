# Base URL should include /api if your backend mounts routes under /api
VITE_API_BASE_URL=http://localhost:5000/api
# A reading newer than this many seconds is considered online, unless backend status overrides it.
VITE_READING_FRESHNESS_SECONDS=90
# Polling interval in milliseconds. Recommended 5000-10000.
VITE_POLL_INTERVAL_MS=7000
